{
  "name": "richdocuments",
  "version": "4.3.0",
  "description": "Collabora Online integration for owncloud.online, modified by BW-Tech GmbH for PHP 8.4 compatibility.",
  "author": "Collabora Productivity based on work of Frank Karlitschek, Victor Dubiniuk, modified by BW-Tech GmbH",
  "modified-by": "BW-Tech GmbH",
  "type": "module",
  "scripts": {
    "lint": "eslint src --ext vue --ext js --ext ts --color",
    "build": "pnpm vite build",
    "build:w": "pnpm vite build --watch --mode development"
  },
  "devDependencies": {
    "@ownclouders/eslint-config": "0.0.1",
    "@ownclouders/extension-sdk": "0.0.1-alpha.4",
    "@ownclouders/prettier-config": "0.0.1",
    "@ownclouders/tsconfig": "0.0.6",
    "@types/node": "^26.4.1",
    "axios": "^1.18.0",
    "eslint": "8.57.1",
    "prettier": "3.8.1",
    "typescript": "4.9.5",
    "vite": "5.4.21",
    "vue": "3.5.30"
  },
  "peerDependencies": {
    "@ownclouders/web-pkg": "^0.0.3"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@ownclouders/web-*",
        "web-*"
      ]
    }
  }
}
